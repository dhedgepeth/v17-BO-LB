{
  "$schema": "./appsettings-schema.json",
  "Serilog": {
    "Using": [ "Serilog.Sinks.AzureBlobStorage" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "AzureBlobStorage",
        "Args": {
          "connectionStringName": "umbracoLogs",
          "storageContainerName": "serilog",
          "storageFileName": "{yyyy}/{MM}/{dd}/{HH}-{MachineName}.txt",
          "writeInBatches": true,
          "period": "0.00:00:30",
          "batchPostingLimit": 100
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoLogs": ""
  },
  "Umbraco": {
    "CMS": {
      "Hosting": {
        "Debug": false,
        "LocalTempStorageLocation": "EnvironmentTemp"
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "AppDomain"
      },
      "Runtime": {
        "Mode": "Production"
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://test.com/"
      },
      "Global": {
        "MainDomLock": "FileSystemMainDomLock"
      },
      "Examine": {
        "LuceneDirectoryFactory": "SyncedTempFileSystemDirectoryFactory"
      }
    }
  }
}
